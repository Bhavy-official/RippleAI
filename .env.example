# Backend runtime
RIPPLE_HOST=127.0.0.1
RIPPLE_PORT=8000
RIPPLE_LOG_PATH=./data/app.log
RIPPLE_WINDOW_SECONDS=60
RIPPLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AWS publishing. Leave blank for local demo mode.
AWS_REGION=
RIPPLE_CLOUDWATCH_LOG_GROUP=
RIPPLE_CLOUDWATCH_LOG_STREAM=
RIPPLE_SNS_TOPIC_ARN=

# Optional future explanation provider. Detection never depends on this value.
OPENAI_API_KEY=
